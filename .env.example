# Copy to .env (gitignored) and fill in. Next.js and the Prisma CLI both read .env.

# --- Database (Neon Postgres, provisioned via Vercel Marketplace) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Non-pooled direct connection used for migrations (prisma migrate / seed).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Vercel Blob (signed waiver PDF storage) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Admin auth ---
# 32+ byte random secret for signing the admin session JWT.
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Seeded admin login (used only by prisma/seed.ts).
ADMIN_EMAIL="admin@youssefyachts.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Youssef Yachts Admin"

# --- App ---
# Absolute base URL used server-side to build guest waiver signing links.
# Leave unset in dev (falls back to the request origin); set in production.
NEXT_PUBLIC_BASE_URL="https://youssef-yachts.vercel.app"

# --- Stripe (payments) ---
# From Stripe Dashboard -> Developers -> API keys. Use test keys first.
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# From the webhook endpoint you create (Dashboard -> Developers -> Webhooks),
# or from `stripe listen` in local dev.
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# "deposit" charges the 50% deposit online; "full" charges the whole amount.
STRIPE_CHARGE_MODE="deposit"

# --- Email confirmations (optional) ---
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Hurry Up Slowly Yachts <charter@hurryupslowly.com>"
EMAIL_ADMIN="charter@hurryupslowly.com"
